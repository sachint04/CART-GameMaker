                "PATH": "D:/msys64/ucrt64/bin;D:/msys64/usr/bin;${env:PATH}"
            }
        }
    ],
    "cmake.defaultKit": "GCC (MSYS2 UCRT64)",
    "C_Cpp.dimInactiveRegions": false
}
